# Environment variables the app reads (see inkbridge/config.py), for local runs:
# export them in your shell. Production does not use this file: settings live in
# k8s/kustomization.yaml (configMapGenerator), credentials in the provider-injected
# `remarkling-secrets` Secret.

# --- Credentials (production: remarkling-secrets) ------------------------------
# `inkbridge register <code>` with a code from my.remarkable.com/device/desktop/connect
RM_DEVICE_TOKEN=
ANTHROPIC_API_KEY=
TRILIUM_ETAPI_TOKEN=
# Bearer token for /push and /poll (iPhone Shortcuts). `openssl rand -hex 32`
API_TOKEN=
# Bearer token for /mcp (claude.ai connector). `openssl rand -hex 32`
MCP_TOKEN=

# --- Settings (production: remarkling-config) ----------------------------------
# Empty or unset means the app's default.
RM_TRANSPORT=cloud
INTERPRET_MODEL=
# Trilium is skipped until TRILIUM_URL, TRILIUM_ETAPI_TOKEN and TRILIUM_PARENT_NOTE are set.
TRILIUM_URL=
TRILIUM_PUBLIC_URL=
TRILIUM_PARENT_NOTE=
MCP_ALLOWED_HOSTS=
POLL_INTERVAL_S=300
RETENTION_DAYS=30
