# Copy to .env.production and fill in. Read only by scripts/deploy.sh; locally
# the app reads the same names from the environment (see inkbridge/config.py).

# --- Deployment infrastructure ----------------------------------------------
# Rendered into the k8s manifests; not secret.
# Public hostname (ingress, TLS cert, MCP_ALLOWED_HOSTS). Needs a DNS record
# pointing at the bugzoo ingress.
DOMAIN=remarkling.derfred.com
# Storage class for the data PVC (SQLite + documents). Immutable once created.
STORAGE_CLASS=longhorn
# Trilium on bugzoo: in-cluster Service for ETAPI, public URL for links.
# Leave TRILIUM_URL empty to disable Trilium.
TRILIUM_URL=http://trilium.trilium.svc.cluster.local
TRILIUM_PUBLIC_URL=https://trilium.derfred.com
POLL_INTERVAL_S=300

# --- Application secrets -----------------------------------------------------
# Written into the remarkling-secrets Secret. Empty values are left out, so the
# app's defaults apply.
RM_TRANSPORT=cloud
# `inkbridge register <code>` with a code from my.remarkable.com/device/desktop/connect
RM_DEVICE_TOKEN=
ANTHROPIC_API_KEY=
INTERPRET_MODEL=
# Trilium ETAPI token and the note ID of the "reMarkable" parent note.
TRILIUM_ETAPI_TOKEN=
TRILIUM_PARENT_NOTE=
# Bearer token for /push and /poll (iPhone Shortcuts). `openssl rand -hex 32`
API_TOKEN=
# Bearer token for /mcp (claude.ai connector). `openssl rand -hex 32`
MCP_TOKEN=
RETENTION_DAYS=30
