# --- Credentials ----------------------------------------------------------------
# `inkbridge register <code>` with a code from my.remarkable.com/device/desktop/connect
RM_DEVICE_TOKEN=
ANTHROPIC_API_KEY=
TRILIUM_ETAPI_TOKEN=
# Bearer token for /push and /poll (iPhone Shortcuts). `openssl rand -hex 32`
API_TOKEN=
# Bearer token for /mcp (claude.ai connector). `openssl rand -hex 32`
MCP_TOKEN=

# --- Settings -------------------------------------------------------------------
# Empty or unset means the app's default.
RM_TRANSPORT=cloud
INTERPRET_MODEL=
# Trilium is skipped until TRILIUM_URL, TRILIUM_ETAPI_TOKEN and TRILIUM_PARENT_NOTE are set.
TRILIUM_URL=
TRILIUM_PUBLIC_URL=
TRILIUM_PARENT_NOTE=
# Public hostname(s), comma-separated; required in production (MCP DNS-rebinding check).
MCP_ALLOWED_HOSTS=
# The poller wakes on the cloud's notifications websocket. Empty derives it from the sync host;
# `off` disables it.
RM_NOTIFICATIONS_URL=
# Seconds between Outbox polls when there is no websocket (default 60). An idle poll is a single request.
POLL_INTERVAL_S=
# Seconds between safety-net polls while the websocket is connected (default 900).
POLL_FALLBACK_S=
# Document store: postgres://user:pass@host:5432/db, sqlite:///relative/path.db or
# sqlite:////absolute/path.db (four slashes). Empty means SQLite at DATA_DIR/inkbridge.sqlite3.
DATABASE_URL=
RETENTION_DAYS=
