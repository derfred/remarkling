# Environment variables the app reads (see inkbridge/config.py), for local runs:
# export them in your shell. Production does not use this file: all of these live
# in the provider-injected `remarkling-secrets` Secret.

# --- Credentials ----------------------------------------------------------------
# `inkbridge register <code>` with a code from my.remarkable.com/device/desktop/connect
RM_DEVICE_TOKEN=
ANTHROPIC_API_KEY=
TRILIUM_ETAPI_TOKEN=
# Bearer token for /push and /poll (iPhone Shortcuts). `openssl rand -hex 32`
API_TOKEN=
# Bearer token for /mcp (claude.ai connector). `openssl rand -hex 32`
MCP_TOKEN=

# --- Settings -------------------------------------------------------------------
# Empty or unset means the app's default.
RM_TRANSPORT=cloud
INTERPRET_MODEL=
# Trilium is skipped until TRILIUM_URL, TRILIUM_ETAPI_TOKEN and TRILIUM_PARENT_NOTE are set.
TRILIUM_URL=
TRILIUM_PUBLIC_URL=
TRILIUM_PARENT_NOTE=
# Public hostname(s), comma-separated; required in production (MCP DNS-rebinding check).
MCP_ALLOWED_HOSTS=
# Seconds between Outbox polls (default 60). An idle poll is a single request.
POLL_INTERVAL_S=
# postgres://user:pass@host:5432/db to keep document state in Postgres; empty means SQLite in DATA_DIR.
DATABASE_URL=
RETENTION_DAYS=
