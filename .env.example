# --- Credentials ----------------------------------------------------------------
# `inkbridge register <code>` with a code from my.remarkable.com/device/desktop/connect
RM_DEVICE_TOKEN=
ANTHROPIC_API_KEY=
TRILIUM_ETAPI_TOKEN=

# --- Settings -------------------------------------------------------------------
# Empty or unset means the app's default.
INTERPRET_MODEL=
# Trilium is skipped until TRILIUM_URL, TRILIUM_ETAPI_TOKEN and TRILIUM_PARENT_NOTE are set.
TRILIUM_URL=
TRILIUM_PUBLIC_URL=
TRILIUM_PARENT_NOTE=
# Host names /mcp answers to, comma-separated: the public one and, for in-cluster clients, the
# Service's. Required in production (MCP DNS-rebinding check). Empty: any host.
# The app does no authentication; protect it in front (see README, "Access control").
MCP_ALLOWED_HOSTS=
# The app's external base URL, for the upload URLs create_upload hands out.
# Empty: https://<first MCP_ALLOWED_HOSTS entry>.
PUBLIC_URL=
# Upload URL lifetime in seconds (default 900) and size limit in MB (default 50; match the Ingress).
UPLOAD_TTL_S=
UPLOAD_MAX_MB=
# The poller wakes on the cloud's notifications websocket. Empty derives it from the sync host;
# `off` disables it.
RM_NOTIFICATIONS_URL=
# Seconds between Outbox polls when there is no websocket (default 60). An idle poll is a single request.
POLL_INTERVAL_S=
# Seconds between safety-net polls while the websocket is connected (default 900).
POLL_FALLBACK_S=
# Document store: postgres://user:pass@host:5432/db, sqlite:///relative/path.db or
# sqlite:////absolute/path.db (four slashes). Empty means SQLite at DATA_DIR/inkbridge.sqlite3.
DATABASE_URL=
RETENTION_DAYS=
